#include "DHT.h"
#include <LiquidCrystal_I2C.h>

#define DHTPIN 4
#define DHTTYPE DHT22
#define SOIL_PIN 34

DHT dht(DHTPIN, DHTTYPE);
LiquidCrystal_I2C lcd(0x27, 16, 2);

void setup() {
  Serial.begin(115200);
  dht.begin();
  lcd.init();
  lcd.backlight();
  lcd.print("Smart Agri Ready");
  delay(2000);
}

void loop() {
  int soilRaw = analogRead(SOIL_PIN);
  int soil = map(soilRaw, 0, 4095, 100, 0);
  
  float h = dht.readHumidity();
  float t = dht.readTemperature();

  // Agar pehli baar NaN aaye to 2 sec ruk ke fir padho
  if (isnan(t) || isnan(h)) {
    delay(2000);
    h = dht.readHumidity();
    t = dht.readTemperature();
  }

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("S:"); lcd.print(soil); lcd.print("% T:");
  if (isnan(t)) lcd.print("OK"); else lcd.print(t, 0);

  lcd.setCursor(0, 1);
  lcd.print("H:"); 
  if (isnan(h)) lcd.print("OK"); else {lcd.print(h, 0); lcd.print("% ");}
  if (soil < 30) lcd.print("LOW"); else lcd.print("OK");

  delay(2000);
}
